{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "pulse-mark",
	"version": "0.1.3",
	"description": "An example icon that lights up when any session is busy, to show how a plugin can read live session data.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"mark",
		"demo",
		"store"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "Pulse Mark",
			"category": "component",
			"defaultEnabled": false,
			"channel": "canary",
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "mark"
		}
	}
}
