{
	"display_information": {
		"name": "Dimension (as you)",
		"description": "Lets your Dimension agent read and send Slack messages as you, through Slack's MCP server."
	},
	"oauth_config": {
		"redirect_urls": [
			"http://localhost:53682/callback"
		],
		"scopes": {
			"user": [
				"canvases:read",
				"canvases:write",
				"channels:history",
				"channels:read",
				"channels:write",
				"chat:write",
				"emoji:read",
				"files:read",
				"files:write",
				"groups:history",
				"groups:read",
				"groups:write",
				"im:history",
				"im:read",
				"im:write",
				"lists:read",
				"lists:write",
				"mpim:history",
				"mpim:read",
				"mpim:write",
				"reactions:read",
				"reactions:write",
				"search:read.files",
				"search:read.im",
				"search:read.mpim",
				"search:read.private",
				"search:read.public",
				"search:read.users",
				"users:read",
				"users:read.email"
			]
		},
		"pkce_enabled": true
	},
	"settings": {
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": true,
		"is_mcp_enabled": true
	}
}
