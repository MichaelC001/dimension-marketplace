{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "classic-dock",
	"version": "0.1.2",
	"description": "The standard right-hand panel as an installable part: its tab strip, resize handle and panel body.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"dock",
		"classic"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "Classic Dock",
			"icon": "layers",
			"category": "component",
			"defaultEnabled": true,
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "dock-column"
		}
	}
}
