{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "triage-rail",
	"version": "0.1.6",
	"description": "A session list built around what needs you: a Needs-you strip with the oldest wait first, then Now, Today, Yesterday and earlier groups, plus one Sweep to archive idle sessions older than a week.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"rail",
		"triage",
		"community"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"requires": { "dimension": ">=0.11.1" },
			"title": "Triage Rail",
			"icon": "bolt",
			"category": "component",
			"standalone": true,
			"defaultEnabled": true,
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "rail"
		}
	}
}
