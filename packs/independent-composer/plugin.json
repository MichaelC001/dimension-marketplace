{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "independent-composer",
	"version": "0.1.3",
	"description": "An example message box built only from the public UI parts, to show how to build your own.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"composer",
		"independent"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"requires": { "dimension": ">=0.11.1" },
			"title": "Independent Composer",
			"category": "component",
			"defaultEnabled": true,
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "composer"
		}
	}
}
