{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "pr-viewer",
	"version": "0.1.7",
	"description": "See a pull request's review in the right-hand panel; with it installed, review chips open here instead of in your browser.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"dock",
		"reviews",
		"pull-request",
		"store"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "PR Viewer",
			"icon": "assets/icon.webp",
			"category": "component",
			"standalone": true,
			"defaultEnabled": true,
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "dock",
			"grants": [
				"scm:review"
			],
			"opens": [
				"review"
			],
			"order": 60
		}
	}
}
