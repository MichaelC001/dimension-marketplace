{
	// TWO PROGRAMS, ONE PACK (the `@dimension/sdk` precedent: packages/sdk/
	// tsconfig.agent.json). This one is the View and the modules it shares with
	// the server. The View is built from `@fraym/ui` SOURCE, which the checker
	// reaches through the import, so it is judged by the KIT's compiler settings
	// (as the browser pack's dock panel is), with the kit's ambient declarations
	// for its CSS / `?url` asset imports. `tsconfig.server.json` is the server
	// and its tests: `@dimension/sdk/general-agent` brings the fork's manifest
	// parser, so OMP source enters that program and is judged by the ENGINE's
	// rules. `check:types` chains both.
	"extends": "../../../fraym/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["bun", "vite/client"]
	},
	"include": [
		"app/view",
		"src/agent-md.ts",
		"src/contracts.ts",
		"src/extra.ts",
		"../../../fraym/packages/ui/src/asset-imports.d.ts",
		"../../../fraym/packages/ui/src/globals.d.ts",
		"../../../fraym/packages/vibr/src/css.d.ts"
	]
}
