{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "artifactory-general-agent",
	"version": "0.3.0",
	"description": "General Agents — every agent you can run, as cards on one page. Open one for its whole profile — tools, skills, plugins, MCP, standing instructions, home, memory and whether it is on and in the rail — and edit it there, or create a new one by hand or by asking the Machinist.",
	"keywords": [
		"general-agents",
		"mcp-apps",
		"agent-builder"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "General Agents",
			"icon": "bot",
			"artifactories": [
				{
					"mcpServer": "general-agent",
					"label": "General Agents",
					"icon": "bot",
					"modelSpaces": [
						"code",
						"build",
						"example-hub",
						"phone",
						"traction"
					],
					"grants": [
						"agents:configure",
						"dock:open",
						"session:open",
						"view:split"
					]
				}
			],
			"railActions": [
				{
					"id": "general-agents",
					"label": "General Agents",
					"icon": "bot",
					"order": 20,
					"target": "page",
					"surface": "page",
					"session": {
						"agent": "machinist",
						"artifactory": {
							"server": "general-agent",
							"tool": "forge_open"
						}
					}
				}
			]
		}
	}
}
