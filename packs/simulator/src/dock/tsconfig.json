{
	// The dock panel runs in the HOST's page against `@fraym/ui`, whose SOURCE the
	// checker reaches through the import — so the panel is checked under the kit's
	// own compiler settings (as the Browser pack's dock is), not the server's, and
	// the root tsconfig excludes this directory.
	"extends": "../../../../../fraym/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node", "react", "react-dom"]
	},
	"include": [".", "../../../../../fraym/packages/ui/src/asset-imports.d.ts", "../../../../../fraym/packages/ui/src/globals.d.ts"]
}
