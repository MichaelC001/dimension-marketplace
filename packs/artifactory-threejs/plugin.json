{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "artifactory-threejs",
	"version": "0.1.3",
	"description": "3D scenes your agent can build and show beside your chat, using the standard Three.js example app.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"artifactory",
		"mcp-apps",
		"three.js",
		"3d",
		"example"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "Three.js",
			"icon": "box",
			"category": "artifactory",
			"defaultEnabled": false,
			"channel": "canary",
			"artifactories": [
				{
					"mcpServer": "threejs",
					"label": "3D scene",
					"icon": "box",
					"modelSpaces": [
						"code"
					]
				}
			]
		}
	}
}
