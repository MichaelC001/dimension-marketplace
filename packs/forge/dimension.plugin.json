				"forge-rail": "rail-t3",
				"forge-dock": "session-board",
				"forge-badge": "mochi-mark"
			},
			"rail": {
				"preferredMode": "expanded",
				"actions": [
					{
						"id": "forge-new-session",
						"label": "New session",
						"icon": "plus",
						"target": "new-session",
						"kbd": "Cmd+N",
						"primary": true
					}
				]
			},
			"workspace": {
				"surfaces": [
					"session"
				],
				"start": "session",
				"session": "session",
				"switchPolicy": "remember",
				"sections": {
